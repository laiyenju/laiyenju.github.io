---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{% comment %}Home and the published notes; /notes/ and /works/ only redirect home, so they stay out.{% endcomment %}
{% assign notes = site.pages | where_exp: "p", "p.path contains 'published/'" | sort: "date" | reverse %}
{% assign last_note = notes | first %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    {% if last_note.date %}<lastmod>{{ last_note.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% for note in notes %}
  <url>
    <loc>{{ note.url | absolute_url }}</loc>
    {% if note.date %}<lastmod>{{ note.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endfor %}
</urlset>
